{
  "Urls": "http://localhost:5170",
  "_AllowedHosts": "Blocks DNS rebinding: without it a hostile domain can point at 127.0.0.1 and the browser treats it as same-origin.",
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "ConnectionStrings": {
    "DigiChat": "Server=(localdb)\\MSSQLLocalDB;AttachDbFilename=%DBDIR%\\DigiChat.mdf;Initial Catalog=DigiChat;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Data": {
    "LineageFile": "data/lineages.json"
  },
  "Twitch": {
    "ClientId": "",
    "IgnoredUserIds": [],
    "MockMode": false,
    "TokenFile": "twitch-tokens.json"
  },
  "Admissions": {
    "MaxParticipantsPerSession": 500
  },
  "Transitions": {
    "StageChangeSeconds": 4,
    "DeathSeconds": 4,
    "ReincarnationSeconds": 12
  },
  "Overlay": {
    "LabelsEnabled": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/digichat-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
